RUST_MANIFEST = rust/Cargo.toml
RUST_TARGET_DIR = rust/target
RUST_LIB = $(RUST_TARGET_DIR)/release/libspacox_cgf.a
RUST_SOURCES = rust/Cargo.toml rust/Cargo.lock rust/src/lib.rs

OBJECTS = cgf_wrapper.o init.o
PKG_LIBS = $(RUST_LIB)

$(SHLIB): $(RUST_LIB)

$(RUST_LIB): $(RUST_SOURCES)
	CARGO_TARGET_DIR=$(RUST_TARGET_DIR) cargo build --manifest-path $(RUST_MANIFEST) --release

clean:
	cargo clean --manifest-path $(RUST_MANIFEST)
	$(RM) $(OBJECTS) $(SHLIB)
